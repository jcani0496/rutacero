# App stack: Railway Postgres + better-auth + Railway Buckets
# (Supabase/Vercel remote projects removed — do not reintroduce SUPABASE_* or
# Vercel project linkage.)
# Optional: used for metadata/OpenAPI docs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payments (Recurrente)
# Local smoke without real dashboard credentials:
# RECURRENTE_MOCK_MODE=true
# Public key (some older configs used RECURRENTE_API_KEY)
RECURRENTE_MOCK_MODE=false
RECURRENTE_PUBLIC_KEY=your-recurrente-public-key
RECURRENTE_API_KEY=your-recurrente-public-key
RECURRENTE_SECRET_KEY=your-recurrente-secret-key
# Get from Recurrente Dashboard → Webhooks → Signing Secret (min 32 chars)
RECURRENTE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Play Billing (Android)
GOOGLE_PLAY_MOCK_MODE=false
GOOGLE_PLAY_PACKAGE_NAME=com.rutacero.app
GOOGLE_PLAY_PRODUCT_ID=pro_pass_30d
NEXT_PUBLIC_GOOGLE_PLAY_PACKAGE_NAME=com.rutacero.app
NEXT_PUBLIC_GOOGLE_PLAY_PRODUCT_ID=pro_pass_30d
# Set to 90 (with matching Google Play SKU pro_pass_90d) for the 90-day pass; default is 30.
GOOGLE_PLAY_PASS_DURATION_DAYS=30
NEXT_PUBLIC_GOOGLE_PLAY_PASS_DURATION_DAYS=30
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=android-publisher@your-project.iam.gserviceaccount.com
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_PLAY_ACCOUNT_SALT=replace-with-a-stable-random-salt

# Emails (Resend)
RESEND_API_KEY=your-resend-api-key

# Auth / data / storage providers (F6 defaults)
AUTH_PROVIDER=better-auth
NEXT_PUBLIC_AUTH_PROVIDER=better-auth
DATA_PROVIDER=drizzle
STORAGE_PROVIDER=railway
NEXT_PUBLIC_STORAGE_PROVIDER=railway

# Local Postgres (docker compose -f docker-compose.db.yml up -d)
DATABASE_URL=postgresql://rutacero:rutacero@localhost:54329/rutacero
BETTER_AUTH_SECRET=replace-with-a-random-32+-char-secret
# Optional override (defaults to NEXT_PUBLIC_APP_URL)
# BETTER_AUTH_URL=http://localhost:3000
# Required when STORAGE_PROVIDER=railway (S3-compatible Railway Buckets).
# Prefer STORAGE_S3_* locally; Railway can auto-inject AWS_* from the bucket.
# Logical product bucket: payment-receipts. S3 API name is globally unique
# (e.g. payment-receipts-d1yaxfcz from `railway bucket credentials`).
# STORAGE_S3_ENDPOINT=https://t3.storageapi.dev
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_BUCKET=payment-receipts-xxxxxxxx
# STORAGE_S3_REGION=auto
# Fallbacks accepted: AWS_ENDPOINT_URL, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_S3_BUCKET_NAME, AWS_DEFAULT_REGION, AWS_S3_URL_STYLE

# Security
# Generate all secrets with: node scripts/generate-secrets.js
# Must be cryptographically random

# Cron job authentication (64 chars minimum)
CRON_SECRET=your-random-cron-secret-min-32-chars-long

# Admin JWT session signing (128 chars recommended)
ADMIN_JWT_SECRET=your-random-jwt-secret-min-64-chars-long

# Rate Limiting (Optional - uses in-memory if not provided)
# Get your free account at https://upstash.com/
UPSTASH_REDIS_REST_URL=your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Logging (Optional - defaults to 'info' in production, 'debug' in development)
LOG_LEVEL=info
# Optional: webhook endpoint for warn/error events (SIEM, Datadog, etc.)
OBSERVABILITY_WEBHOOK_URL=

# Login security (Optional)
# Hours after last failed attempt to reset progressive lockout counter
LOGIN_LOCKOUT_RESET_HOURS=24
# Retention for lockout rows in maintenance cron
LOGIN_LOCKOUT_RETENTION_DAYS=90
# Retention for processed payment webhook events
WEBHOOK_EVENT_RETENTION_DAYS=30

# Admin hardening (Optional)
# Base32 secret for admin TOTP MFA (if empty, MFA is disabled)
ADMIN_MFA_TOTP_SECRET=
# Max password age in days for admin accounts (0 disables expiration)
ADMIN_PASSWORD_MAX_AGE_DAYS=90

# Sentry (free tier)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Manual bank transfer instructions (JSON array of BankAccount)
# Each: { "bank": "...", "accountType": "...", "accountNumber": "...", "accountName": "..." }
BANK_TRANSFER_INSTRUCTIONS_JSON=[]
