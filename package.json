{
  "name": "rutacero",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:run && npm run test:e2e:critical && npm run build",
    "db:push:local": "supabase db push --local --include-all --yes",
    "db:reset:local": "supabase db reset --local --yes",
    "backup:local": "bash scripts/backup-local.sh",
    "backup:prod": "bash scripts/backup-prod.sh",
    "restore:local": "bash scripts/restore-local.sh",
    "verify:restore": "bash scripts/verify-local-restore.sh",
    "verify:restore:staging": "bash scripts/verify-staging-restore.sh",
    "verify:smoke:local": "bash scripts/verify-release-smoke.sh",
    "seed:admin": "node scripts/seed-admin.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:security": "vitest run __tests__/security/rls-webhook.integration.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:login": "playwright test e2e/login.spec.ts",
    "test:e2e:critical": "playwright test e2e/login.spec.ts e2e/plan.spec.ts e2e/a11y.spec.ts",
    "test:all": "npm run test:run && npm run test:e2e",
    "android:sync": "cap sync android && node scripts/sanitize-capacitor-android-config.js",
    "android:sync:emulator": "CAPACITOR_SERVER_URL=http://10.0.2.2:3000 npm run android:sync",
    "android:sync:prod": "CAPACITOR_SERVER_URL=https://rutacero.vercel.app npm run android:sync",
    "android:open": "cap open android",
    "android:start:emulator": "bash scripts/start-android-emulator.sh",
    "android:build:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:build:prod": "CAPACITOR_SERVER_URL=https://rutacero.vercel.app npm run android:build:debug",
    "android:build:emulator": "CAPACITOR_SERVER_URL=http://10.0.2.2:3000 npm run android:build:debug",
    "android:run:emulator": "bash scripts/run-android-emulator.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^1.0.2",
    "@sentry/nextjs": "^10.52.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.89.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.26",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.562.0",
    "next": "^16.2.2",
    "next-themes": "^0.4.6",
    "otplib": "^13.3.0",
    "p-retry": "^7.1.1",
    "pino": "^10.1.1",
    "pino-pretty": "^13.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.69.0",
    "recharts": "^3.6.0",
    "resend": "^6.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@capacitor/cli": "^8.3.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.0.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.17",
    "eslint": "^9",
    "eslint-config-next": "^16.2.2",
    "happy-dom": "^20.1.0",
    "jest-axe": "^10.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-react": "^5.31.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.17"
  }
}
